generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  phone         String
  product       String
  amount        Float
  status        String   @default("PENDING")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}